<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-pricing-rules-v2" author="sadiq">

        <createTable tableName="pricing_rules">

            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="max_weight" type="DOUBLE"/>

            <column name="max_distance" type="DOUBLE"/>

            <column name="base_price" type="DOUBLE"/>

            <column name="extra_price_per_kg" type="DOUBLE"/>

            <column name="extra_price_per_km" type="DOUBLE"/>

            <column name="standard_delivery" type="VARCHAR(255)"/>

        </createTable>

    </changeSet>

</databaseChangeLog>