<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="7" author="sadiq">

        <!-- shipment 1-1 relation -->
        <addForeignKeyConstraint
                baseTableName="deliveries"
                baseColumnNames="shipment_id"
                referencedTableName="shipments"
                referencedColumnNames="id"
                constraintName="fk_delivery_shipment"/>

        <!-- courier relation -->
        <addForeignKeyConstraint
                baseTableName="deliveries"
                baseColumnNames="courier_id"
                referencedTableName="user"
                referencedColumnNames="id"
                constraintName="fk_delivery_courier"/>

    </changeSet>

</databaseChangeLog>