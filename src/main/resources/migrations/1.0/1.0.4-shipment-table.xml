<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="5" author="sadiq">
        <createTable tableName="shipments">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="tracking_number" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="sender_name" type="VARCHAR(255)"/>
            <column name="sender_phone" type="VARCHAR(20)"/>

            <column name="receiver_name" type="VARCHAR(255)"/>
            <column name="receiver_phone" type="VARCHAR(20)"/>

            <column name="delivery_address" type="VARCHAR(500)"/>

            <column name="weight" type="DOUBLE"/>
            <column name="price" type="DOUBLE"/>

            <column name="created_by" type="BIGINT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>